{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Video Factory Storyboard",
  "type": "object",
  "required": ["project_id", "format", "shots"],
  "properties": {
    "project_id": {"type": "string"},
    "format": {
      "type": "object",
      "required": ["panels", "aspect_ratio", "board_layout"],
      "properties": {
        "panels": {"const": 16},
        "aspect_ratio": {"type": "string"},
        "board_layout": {"const": "4x4"}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "duration", "purpose", "visual", "action", "camera", "lighting", "continuity"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 16},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "purpose": {"type": "string"},
          "visual": {"type": "string"},
          "action": {"type": "string"},
          "camera": {"type": "string"},
          "lighting": {"type": "string"},
          "continuity": {"type": "string"}
        }
      }
    }
  }
}
